[Unit]
Description=Monitor técnico do Assistente Acadêmico
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/servidor/sites/assistente-academico
Environment=ASSISTENTE_SITE_URL=https://trab.sivaldodavi.com.br
Environment=ASSISTENTE_CONTAINER=site-assistente-academico
Environment=ASSISTENTE_DATABASE=/opt/servidor/data/assistente-academico/assistente_v2.sqlite3
Environment=ASSISTENTE_MONITOR_STATE=/var/lib/assistente-monitor/state.json
ExecStart=/usr/bin/python3 /opt/servidor/sites/assistente-academico/ops/assistente_monitor.py
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/assistente-monitor
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Unit]
Description=Backup SQLite do Assistente Acadêmico
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/assistente-db-backup
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/servidor/backups

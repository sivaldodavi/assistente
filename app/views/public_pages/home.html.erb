<% content_for :title, current_account.present? && !public_shell_only? ? "Início — Assistente Acadêmico" : "Assistente Acadêmico" %>

<% if current_account.present? && !public_shell_only? %>
  <%= render "dashboard" %>
<% else %>
  <% login_available = google_oauth_configured? && !public_shell_only? %>
  <header class="site-header">
    <%= link_to root_path, class: "brand" do %><span class="brand-mark" aria-hidden="true">AA</span> Assistente Acadêmico<% end %>
    <nav class="header-actions" aria-label="Navegação principal">
      <%= link_to "Pacotes", plans_path, class: "header-link" %>
      <% unless login_available %>
        <span class="header-link">Acesso em preparação</span>
      <% end %>
    </nav>
  </header>

  <main class="page-shell public-home">
    <section class="public-hero">
      <div class="public-hero-copy">
        <p class="eyebrow">Case e paper jurídicos</p>
        <h1>Seu trabalho, com método.</h1>
        <p>Roteiro por etapa, datas de entrega e formatação ABNT, num só lugar.</p>
        <% if login_available %>
          <div class="public-hero-actions">
            <%= button_to "Entrar com Google", "/auth/google_oauth2", method: :post, class: "button button-primary" %>
            <%= link_to "Ver pacotes", plans_path, class: "button button-secondary" %>
          </div>
          <p class="field-hint">Entrada somente com conta Google.</p>
        <% else %>
          <div class="public-hero-actions">
            <span class="preview-label">Acesso em preparação</span>
            <%= link_to "Ver pacotes", plans_path, class: "button button-secondary" %>
          </div>
        <% end %>
        <div class="public-links">
          <%= link_to "Termos", terms_path %>
          <%= link_to "Privacidade", privacy_path %>
          <%= link_to "Como funciona a IA", ai_help_path %>
        </div>
      </div>
      <aside class="public-video" aria-label="Vídeo de apresentação">
        <p class="eyebrow">Veja como funciona</p>
        <div class="public-video-frame">
          <iframe
            src="https://www.youtube-nocookie.com/embed/XC6mObyhb8Q?rel=0&amp;modestbranding=1&amp;playsinline=1"
            title="Assistente Acadêmico: como o site funciona"
            loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
      </aside>
    </section>
  </main>
<% end %>

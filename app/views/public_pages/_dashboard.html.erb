<main class="page-shell dashboard-page">
  <header class="page-heading">
    <div>
      <p class="eyebrow">Seu espaço de trabalho</p>
      <h1>Início</h1>
    </div>
    <div class="page-heading-actions">
      <%= link_to "+ Novo projeto", new_project_path, class: "button button-primary" %>
      <%= link_to "Começar com IA", project_assistant_path, class: "button button-secondary" %>
    </div>
  </header>

  <div class="dashboard-grid">
    <% if @recent_project %>
      <section class="dashboard-card">
        <p class="eyebrow">Continue de onde parou</p>
        <div class="dashboard-resume">
          <div class="dashboard-resume-copy">
            <span class="project-type"><%= project_type_label(@recent_project.project_type) %></span>
            <h2><%= @recent_project.title %></h2>
            <p class="dashboard-progress"><%= @recent_project.section_for["title"] %> · <%= @recent_project.progress["done"] %> de <%= @recent_project.progress["total"] %> campos obrigatórios</p>
            <% if (assessment = @recent_project.latest_jev_assessment) %>
              <p class="project-jev-score"><strong>Avaliação · <%= jev_stage_label(assessment.stage) %>:</strong> <%= jev_assessment_score(assessment) %></p>
              <p class="project-jev-date">Revisão <%= assessment.project_revision.revision %> · avaliação formativa</p>
            <% end %>
          </div>
          <%= link_to "Continuar", project_path(@recent_project, stage: @recent_project.current_stage), class: "button button-primary" %>
        </div>
      </section>
    <% end %>

    <section class="dashboard-card" aria-labelledby="upcoming-title">
      <h2 id="upcoming-title">Próximas entregas</h2>
      <% if @upcoming_deliveries.any? %>
        <div class="delivery-list">
          <% @upcoming_deliveries.each do |delivery| %>
            <% days_left = (delivery[:date] - Date.current).to_i %>
            <%= link_to project_path(delivery[:project], stage: delivery[:project].current_stage), class: "delivery-item" do %>
              <span class="delivery-date"><strong><%= delivery[:date].strftime("%d/%m") %></strong></span>
              <span class="delivery-copy"><strong><%= delivery[:project].title %></strong><span><%= project_type_label(delivery[:project].project_type) %> · <%= delivery[:label] %></span></span>
              <span class="delivery-relative"><%= days_left.zero? ? "Hoje" : "em #{days_left} dias" %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state-copy">Nenhuma entrega futura cadastrada.</p>
      <% end %>
    </section>

    <% if !@profile_complete || (@has_projects && !@has_delivery_dates) %>
      <section class="dashboard-card dashboard-wide" aria-labelledby="next-steps-title">
        <h2 id="next-steps-title">Próximos passos</h2>
        <ul class="onboarding-list">
          <% unless @profile_complete %>
            <li><span>Complete seu perfil acadêmico.</span><%= link_to "Completar perfil", account_settings_path(anchor: "profile") %></li>
          <% end %>
          <% if @has_projects && !@has_delivery_dates %>
            <% project = @projects.first %>
            <li><span>Adicione a próxima data de entrega.</span><%= link_to "Abrir projeto", project_path(project, stage: project.current_stage) %></li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</main>

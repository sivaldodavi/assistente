<% content_for :title, "Pacotes — Assistente Acadêmico" %>

<% if current_account.blank? || public_shell_only? %>
  <header class="site-header">
    <%= link_to "Assistente Acadêmico", root_path, class: "brand" %>
    <div class="header-actions">
      <% if public_shell_only? %>
        <span class="header-link">Acesso em preparação</span>
      <% elsif current_account %>
        <%= link_to "Meus projetos", projects_path, class: "header-link" %>
        <%= link_to "Minha conta", account_settings_path, class: "header-link" %>
      <% elsif google_oauth_configured? %>
        <%= button_to "Entrar", "/auth/google_oauth2", method: :post, class: "header-link", form: { class: "header-login-form" } %>
      <% else %>
        <%= link_to "Entrar", login_path, class: "header-link" %>
      <% end %>
    </div>
  </header>
<% end %>

<% project_packages, ai_packages = @packages.partition { |_code, package| package[:kind] != :topup } %>
<% checkout = current_account.present? && !public_shell_only? %>

<main class="page-shell package-page">
  <header class="package-page-heading">
    <h1>Pacotes</h1>
  </header>

  <% if public_shell_only? %>
    <p class="field-hint">Login e compras estarão disponíveis depois da validação das integrações.</p>
  <% end %>

  <% if checkout %>
    <div class="checkout-layout" data-checkout>
      <div class="checkout-options" role="radiogroup" aria-label="Pacotes disponíveis">
  <% end %>

        <section class="package-section" aria-labelledby="project-packages-title">
          <p class="eyebrow">Projetos</p>
          <h2 id="project-packages-title">Escolha um plano</h2>
          <div class="package-grid">
            <% project_packages.each do |code, package| %>
              <%= render "payments/option", code:, package:, checkout: %>
            <% end %>
          </div>
        </section>

        <% if ai_packages.any? %>
          <section class="package-section" aria-labelledby="ai-packages-title">
            <p class="eyebrow">IA</p>
            <h2 id="ai-packages-title">Créditos de IA</h2>
            <p class="muted">Use para orientação, sugestões e organização dos seus trabalhos.</p>
            <div class="package-grid">
              <% ai_packages.each do |code, package| %>
                <%= render "payments/option", code:, package:, checkout: %>
              <% end %>
            </div>
          </section>
        <% end %>

  <% if checkout %>
      </div>

      <aside class="checkout-summary" aria-label="Resumo da compra">
        <h2>Resumo</h2>
        <p class="muted" data-checkout-empty>Escolha um pacote para ver o valor.</p>
        <div class="checkout-details" data-checkout-details hidden>
          <p class="checkout-item" data-checkout-item></p>
          <p class="checkout-total"><span>Total</span><strong data-checkout-total></strong></p>
          <button class="button button-primary" type="button" data-buy-package disabled>Gerar Pix</button>
          <p class="field-hint" data-payment-status role="status" aria-live="polite"></p>
          <div class="payment-result" data-payment-result aria-live="polite"></div>
        </div>
        <p class="field-hint">Liberado automaticamente após a confirmação do Pix.</p>
      </aside>
    </div>
    <%= javascript_include_tag "payment_checkout", defer: true %>
  <% end %>

  <p class="field-hint">Ao comprar, você confirma que leu os <%= link_to "termos de uso", terms_path %> e a <%= link_to "política de privacidade", privacy_path %>. Saiba também <%= link_to "como funciona a IA", ai_help_path %>.</p>
</main>

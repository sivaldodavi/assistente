<% page_title = content_for(:title).presence || "Assistente Acadêmico" %>
<% page_description = content_for(:description).presence || "Planeje e desenvolva Cases e Papers jurídicos com roteiros por etapa e exportação em PDF no padrão ABNT." %>
<% social_image_url = "#{request.base_url}/social-preview.png" %>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#102a43">
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= "#{request.base_url}#{request.path}" %>">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="Assistente Acadêmico">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= "#{request.base_url}#{request.path}" %>">
    <meta property="og:image" content="<%= social_image_url %>">
    <meta property="og:image:secure_url" content="<%= social_image_url %>">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Assistente Acadêmico — Seu trabalho, com método.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= social_image_url %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Assistente Academico">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <% authenticated_shell = current_account.present? && !public_shell_only? %>
  <body class="<%= "has-app-shell" if authenticated_shell %>">
    <% if flash[:notice] %><div class="flash flash-notice" role="status"><%= flash[:notice] %></div><% end %>
    <% if flash[:alert] %><div class="flash flash-alert" role="alert"><%= flash[:alert] %></div><% end %>
    <% if authenticated_shell %>
      <div class="app-shell">
        <%= render "shared/sidebar" %>
        <div class="app-main">
          <div class="app-main-toolbar">
            <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M3 5h14M3 10h14M3 15h14"/>
              </svg>
              <span data-sidebar-toggle-label>Ocultar navegação</span>
            </button>
          </div>
          <button class="sidebar-backdrop" type="button" data-sidebar-backdrop aria-label="Fechar menu" hidden></button>
          <%= yield %>
        </div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
    <%= javascript_include_tag "workflow_editor", defer: true %>
  </body>
</html>

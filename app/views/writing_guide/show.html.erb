<% content_for :title, "Guia de escrita — Assistente Acadêmico" %>

<main class="page-shell narrow-shell writing-guide-page">
  <header class="writing-guide-heading">
    <p class="eyebrow">Guia de escrita</p>
    <h1>O que você quer entender?</h1>
    <p>Faça uma pergunta sobre estrutura, pesquisa ou formatação.</p>
  </header>
  <section class="studio-panel">
    <div class="prompt-suggestions" aria-label="Perguntas sugeridas">
      <% @suggested_questions.each do |suggestion| %>
        <button type="button" class="prompt-chip" data-guide-prompt="<%= suggestion %>"><%= suggestion %></button>
      <% end %>
    </div>
    <%= form_with url: writing_guide_questions_path, data: { guide_form: true } do %>
      <%= label_tag :question, "Sua pergunta" %>
      <%= text_area_tag :question, @question, id: "question", rows: 4, maxlength: WritingGuide::MAX_QUESTION_LENGTH, class: "text-control", required: true, placeholder: "Escreva sua dúvida..." %>
      <p class="privacy-note">A resposta pode conter erros. Confira as fontes e as regras da sua disciplina.</p>
      <%= submit_tag "Pedir orientação", class: "button button-primary", disabled: current_account.deepseek_credits_remaining.zero? %>
      <% if current_account.deepseek_credits_remaining.zero? %>
        <p class="inline-notice">Sem créditos de IA. <%= link_to "Ver Pacotes", plans_path %></p>
      <% else %>
        <p class="muted"><%= current_account.deepseek_credits_remaining %> créditos de IA disponíveis.</p>
      <% end %>
    <% end %>

    <% if @answer %>
      <section class="guide-answer" aria-live="polite">
        <h2>Resposta</h2>
        <%= simple_format(@answer) %>
      </section>
    <% end %>
  </section>
  <p class="inline-support">Precisa de ajuda? <%= link_to "Fale com o suporte", "https://www.instagram.com/sivaldo.davi/", target: "_blank", rel: "noopener noreferrer" %>.</p>
</main>

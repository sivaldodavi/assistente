<aside class="app-sidebar" id="app-sidebar">
  <%= link_to root_path, class: "sidebar-brand" do %>
    <span class="brand-mark" aria-hidden="true">AA</span>
    <span><strong>Assistente</strong><small>Acadêmico</small></span>
  <% end %>

  <nav class="sidebar-nav" aria-label="Navegação principal">
    <%= link_to root_path, class: ("is-active" if current_page?(root_path)), aria: { current: ("page" if current_page?(root_path)) } do %>
      <%= navigation_icon(:home) %> Início
    <% end %>
    <%= link_to projects_path, class: ("is-active" if current_page?(projects_path)), aria: { current: ("page" if current_page?(projects_path)) } do %>
      <%= navigation_icon(:projects) %> Projetos
    <% end %>
    <%= link_to chat_path, class: ("is-active" if current_page?(chat_path)), aria: { current: ("page" if current_page?(chat_path)) } do %>
      <%= navigation_icon(:chat) %> Chat com IA
    <% end %>
    <%= link_to library_path, class: ("is-active" if current_page?(library_path)), aria: { current: ("page" if current_page?(library_path)) } do %>
      <%= navigation_icon(:library) %> Biblioteca
    <% end %>
    <%= link_to metrics_path, class: ("is-active" if current_page?(metrics_path)), aria: { current: ("page" if current_page?(metrics_path)) } do %>
      <%= navigation_icon(:metrics) %> Métricas
    <% end %>
  </nav>

  <%= render "shared/credit_summary" %>

  <div class="sidebar-bottom">
    <%= link_to "Pacotes", plans_path, class: "sidebar-secondary-link" %>
    <% if current_account.admin? %><%= link_to "Administração", admin_dashboard_path, class: "sidebar-secondary-link" %><% end %>
    <%= link_to "Suporte", "https://www.instagram.com/sivaldo.davi/", class: "sidebar-secondary-link", target: "_blank", rel: "noopener noreferrer" %>
    <details class="profile-menu">
      <summary>
        <span class="profile-avatar" aria-hidden="true"><%= current_account.name.to_s.split.map(&:first).first(2).join.upcase.presence || "AA" %></span>
        <span class="profile-name"><strong><%= current_account.name.presence || "Minha conta" %></strong><small><%= current_account.email %></small></span>
        <span class="profile-chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="profile-popover">
        <%= link_to "Minha conta", account_settings_path(anchor: "profile") %>
        <%= link_to "Créditos e pacotes", account_settings_path(anchor: "credits") %>
        <%= button_to "Sair", logout_path, method: :delete, class: "profile-signout" %>
      </div>
    </details>
  </div>
</aside>

<% content_for :title, "Criar trabalho — Assistente Acadêmico" %>

<main class="page-shell narrow-shell" data-project-studio data-draft-url="<%= project_assistant_draft_path %>">
  <header class="writing-guide-heading">
    <%= link_to "Projetos", projects_path, class: "back-link" %>
    <p class="eyebrow">Novo trabalho</p>
    <h1>Por onde quer começar?</h1>
    <p>Conte sua ideia ou organize um texto que já tem.</p>
  </header>
  <section class="studio-panel">
    <div class="studio-balance">
    <% if current_account.deepseek_credits_remaining.zero? %>
      <span>Sem créditos de IA.</span> <%= link_to "Ver Pacotes", plans_path %>
    <% else %>
      <span><%= current_account.deepseek_credits_remaining %> créditos de IA</span>
      <span class="muted">· 1 por solicitação</span>
    <% end %>
    </div>
    <% if !current_account.admin? && current_account.project_credits_remaining.zero? %>
      <p class="inline-notice">Você precisa de um crédito de projeto para salvar. <%= link_to "Ver Pacotes", plans_path %></p>
    <% end %>

    <form data-studio-request>
      <div class="field">
        <label for="studio-project-type">Tipo de trabalho</label>
        <select id="studio-project-type" class="text-control" data-studio-project-type>
          <option value="case">Case</option>
          <option value="paper_project">Projeto de Paper</option>
        </select>
      </div>
      <div class="field">
        <label for="studio-mode">Como quer começar?</label>
        <select id="studio-mode" class="text-control" data-studio-mode>
          <option value="guided">Quero desenvolver uma ideia</option>
          <option value="import">Quero organizar um texto existente</option>
        </select>
      </div>
      <div class="prompt-suggestions" aria-label="Sugestões para começar">
        <% [
          "Ajude-me a escolher e delimitar um tema",
          "Quero transformar este assunto em uma pergunta de pesquisa",
          "Faça perguntas para eu estruturar meu trabalho"
        ].each do |suggestion| %>
          <button type="button" class="prompt-chip" data-studio-prompt-suggestion="<%= suggestion %>"><%= suggestion %></button>
        <% end %>
      </div>
      <div class="field">
        <label for="studio-prompt">Sua ideia</label>
        <textarea id="studio-prompt" class="text-control" rows="4" maxlength="6000" data-studio-prompt placeholder="Escreva do seu jeito; não precisa estar pronto."></textarea>
      </div>
      <div class="field">
        <label for="studio-source-text">Texto existente <span class="muted">(opcional)</span></label>
        <textarea id="studio-source-text" class="text-control" rows="6" maxlength="24000" data-studio-source placeholder="Cole um trecho para receber uma proposta de organização."></textarea>
      </div>
      <p class="privacy-note">O texto será enviado para um serviço de IA; só entra no trabalho quando você selecionar os campos.</p>
      <button class="button button-primary" type="submit" <%= "disabled" if current_account.deepseek_credits_remaining.zero? || (!current_account.admin? && current_account.project_credits_remaining.zero?) %>>Continuar</button>
    </form>

    <p class="field-hint" data-studio-status role="status" aria-live="polite"></p>
    <section class="studio-results" data-studio-results hidden aria-live="polite">
      <div class="studio-answer" data-studio-answer></div>
      <section data-studio-questions-section hidden>
        <h2>Perguntas para desenvolver sua ideia</h2>
        <div data-studio-questions></div>
        <button class="button button-secondary" type="button" data-studio-continue>Continuar com minhas respostas</button>
      </section>
      <section data-studio-suggestions-section hidden>
        <h2>Propostas editáveis para o roteiro</h2>
        <p class="field-hint">Revise cada texto. Marque apenas os campos que deseja incluir; nada é aplicado sem sua seleção.</p>
        <div class="studio-suggestions" data-studio-suggestions></div>
        <%= form_with url: projects_path, scope: :project, class: "studio-create-form", data: { studio_create_form: true } do |form| %>
          <%= form.hidden_field :project_type, data: { studio_create_type: true } %>
          <%= form.submit "Criar projeto com os campos selecionados", class: "button button-primary", data: { studio_create_button: true } %>
        <% end %>
      </section>
    </section>
  </section>
  <p class="inline-support">Precisa de ajuda? <%= link_to "Fale com o suporte", "https://www.instagram.com/sivaldo.davi/", target: "_blank", rel: "noopener noreferrer" %>.</p>
</main>

<% content_for :title, "Configurações da conta — Assistente Acadêmico" %>

<header class="site-header">
  <%= link_to "Assistente Acadêmico", projects_path, class: "brand" %>
  <div class="header-actions">
    <%= link_to "Meus projetos", projects_path, class: "header-link" %>
    <%= link_to "Biblioteca Pessoal", library_path, class: "header-link" %>
    <% if current_account.admin? %><%= link_to "Administração", admin_dashboard_path, class: "header-link" %><% end %>
    <%= button_to "Sair", logout_path, method: :delete, class: "text-button" %>
  </div>
</header>

<main class="page-shell narrow-shell">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Preferências pessoais</p>
      <h1>Configurações da conta</h1>
    </div>
  </div>

  <% if params[:saved] == "profile" %>
    <p class="notice" role="status">Perfil atualizado.</p>
  <% elsif params[:saved] == "terms" %>
    <p class="notice" role="status">Preferências de consentimento salvas.</p>
  <% end %>

  <section class="panel">
    <h2>Pacote e créditos</h2>
    <p>Pacote atual: <strong><%= @account.plan_code.humanize %></strong></p>
    <p><%= @account.project_credits_remaining %> créditos de projeto · <%= [@account.ai_limit - @account.ai_used, 0].max %> avaliações JEV · <%= @account.deepseek_credits_remaining %> usos DeepSeek</p>
    <%= link_to "Comprar créditos por Pix", plans_path, class: "button button-primary" %>
  </section>

  <section class="panel">
    <h2>Perfil</h2>
    <p>Seu nome de identificação é independente das informações acadêmicas do perfil.</p>
    <%= form_with url: account_update_profile_path, method: :post do |form| %>
      <div class="field-grid">
        <div class="field">
          <%= form.label :name, "Nome" %>
          <%= form.text_field :name, value: @account.name, maxlength: 160, class: "text-control" %>
        </div>
        <% %w[institution course discipline professor city].each do |key| %>
          <div class="field">
            <%= form.label key, { "institution" => "Instituição", "course" => "Curso", "discipline" => "Disciplina", "professor" => "Professor(a)", "city" => "Cidade" }.fetch(key) %>
            <%= form.text_field key, value: @account.profile[key], maxlength: 160, class: "text-control" %>
          </div>
        <% end %>
        <div class="field">
          <%= form.label :disciplines, "Disciplinas frequentes (uma por linha)" %>
          <%= form.text_area :disciplines, value: Array(@account.profile["disciplines"]).join("\n"), rows: 4, class: "text-control" %>
        </div>
        <div class="field">
          <%= form.label :teachers, "Orientadores/professores frequentes (um por linha)" %>
          <%= form.text_area :teachers, value: Array(@account.profile["teachers"]).join("\n"), rows: 4, class: "text-control" %>
        </div>
      </div>
      <%= form.submit "Salvar perfil", class: "button button-primary" %>
    <% end %>
  </section>

  <section class="panel" id="terms">
    <h2>Termos de uso e privacidade</h2>
    <% if @account.terms_accepted? %>
      <p>Termos aceitos na versão <%= @account.terms_version %>.</p>
    <% else %>
      <p>Para continuar usando os recursos da conta, aceite os termos de uso e privacidade aplicáveis ao serviço.</p>
    <% end %>
    <%= form_with url: account_accept_terms_path, method: :post do |form| %>
      <div class="field">
        <label><%= check_box_tag :accept, "on", @account.terms_accepted? %> Li e aceito os <%= link_to "termos de uso", terms_path, target: "_blank", rel: "noopener" %> e a <%= link_to "política de privacidade", privacy_path, target: "_blank", rel: "noopener" %>.</label>
      </div>
      <div class="field">
        <label><%= check_box_tag :ai_consent, "on", @account.ai_consent? %> Autorizo o uso da assistência de IA</label>
        <p>Esta autorização é opcional e separada da aceitação dos termos. <%= link_to "Saiba como os serviços de IA funcionam", ai_help_path, target: "_blank", rel: "noopener" %>.</p>
      </div>
      <%= form.submit "Salvar consentimentos", class: "button button-primary" %>
    <% end %>
  </section>

  <section class="panel" id="delete-account">
    <h2>Excluir conta</h2>
    <p>Todos os dados da sua conta serão excluídos permanentemente.</p>
    <%= form_with url: account_delete_path, method: :post do |form| %>
      <div class="field">
        <%= form.label :confirmation, "Digite #{@account.email} para confirmar" %>
        <%= form.email_field :confirmation, required: true, autocomplete: "off", class: "text-control" %>
      </div>
      <%= form.submit "Excluir minha conta e meus dados", class: "button button-danger" %>
    <% end %>
  </section>
</main>

<% content_for :title, "Configurações — Assistente Acadêmico" %>

<main class="page-shell settings-page">
  <div class="settings-panel">
    <nav class="settings-nav" aria-label="Seções das configurações">
      <h2>Configurações</h2>
      <div class="settings-nav-links">
        <a href="#credits">Créditos</a>
        <a href="#profile">Perfil</a>
        <a href="#terms">Consentimentos</a>
        <a href="#delete-account">Excluir conta</a>
      </div>
    </nav>

    <div class="settings-content">
      <header class="settings-heading">
        <div>
          <p class="eyebrow">Minha conta</p>
          <h1 id="settings-title">Perfil e preferências</h1>
          <p class="muted"><%= @account.email %> · identidade gerenciada pelo Google</p>
        </div>
      </header>

      <section class="settings-section" id="credits" aria-labelledby="credits-title">
        <h2 id="credits-title">Pacote e créditos</h2>
        <p>Pacote atual: <strong><%= @account.plan_code.humanize %></strong></p>
        <div class="settings-credit-grid">
          <div class="settings-credit-card">
            <strong><%= @account.project_credits_remaining %></strong>
            <span>créditos de projeto</span>
          </div>
          <div class="settings-credit-card <%= "is-low" if @account.deepseek_credits_remaining <= 5 %>">
            <strong><%= @account.deepseek_credits_remaining %></strong>
            <span>créditos de IA</span>
            <% if @account.deepseek_credits_remaining <= 5 %><p role="status">Seu saldo de IA está baixo.</p><% end %>
          </div>
        </div>
        <%= link_to "Ver Pacotes", plans_path, class: "button button-secondary" %>
      </section>

      <section class="settings-section" id="profile" aria-labelledby="profile-title">
        <h2 id="profile-title">Perfil acadêmico</h2>
        <p>Essas informações podem preencher automaticamente campos dos seus roteiros.</p>
        <% if @account.errors.any? %><div class="alert" role="alert"><%= @account.errors.full_messages.to_sentence %></div><% end %>
        <%= form_with url: account_update_profile_path, method: :post do |form| %>
          <div class="field-grid">
            <div class="field">
              <%= form.label :name, "Nome" %>
              <%= form.text_field :name, value: @account.name, maxlength: 160, class: "text-control" %>
            </div>
            <div class="field">
              <%= form.label :institution, "Faculdade ou instituição de ensino" %>
              <%= form.text_field :institution, value: @account.profile["institution"], maxlength: Account::PROFILE_TEXT_LIMIT, required: true, autocomplete: "organization", class: "text-control" %>
            </div>
            <% %w[course city].each do |key| %>
              <div class="field">
                <%= form.label key, { "course" => "Curso", "city" => "Cidade" }.fetch(key) %>
                <%= form.text_field key, value: @account.profile[key], maxlength: 160, class: "text-control" %>
              </div>
            <% end %>
            <div class="field">
              <%= form.label :period, "Período que você cursa" %>
              <%= form.select :period, options_for_select([ [ "Selecione…", "" ] ] + (1..10).map { |period| [ "#{period}º período", period.to_s ] }, @account.profile["period"]), {}, class: "text-control" %>
            </div>
            <div class="field">
              <%= form.label :shift, "Turno" %>
              <%= form.select :shift, options_for_select([ [ "Selecione…", "" ], [ "Matutino", "matutino" ], [ "Noturno", "noturno" ] ], @account.profile["shift"]), {}, class: "text-control" %>
            </div>
            <div class="field">
              <%= form.label :disciplines, "Disciplinas frequentes (uma por linha)" %>
              <%= form.text_area :disciplines, value: Array(@account.profile["disciplines"]).join("\n"), rows: 4, class: "text-control" %>
            </div>
            <div class="field">
              <%= form.label :teachers, "Orientadores/professores frequentes (um por linha)" %>
              <%= form.text_area :teachers, value: Array(@account.profile["teachers"]).join("\n"), rows: 4, class: "text-control" %>
            </div>
          </div>
          <%= form.submit "Salvar perfil", class: "button button-primary" %>
        <% end %>
      </section>

      <section class="settings-section" id="terms" aria-labelledby="terms-title">
        <h2 id="terms-title">Termos e assistência de IA</h2>
        <% if @account.terms_accepted? %>
          <p>Termos aceitos na versão <%= @account.terms_version %>.</p>
        <% else %>
          <p>Para continuar usando os recursos da conta, aceite os termos de uso e privacidade.</p>
        <% end %>
        <%= form_with url: account_accept_terms_path, method: :post do |form| %>
          <div class="field">
            <label><%= check_box_tag :accept, "on", @account.terms_accepted? %> Li e aceito os <%= link_to "termos de uso", terms_path, target: "_blank", rel: "noopener" %> e a <%= link_to "política de privacidade", privacy_path, target: "_blank", rel: "noopener" %>.</label>
          </div>
          <div class="field">
            <label><%= check_box_tag :ai_consent, "on", @account.ai_consent? %> Autorizo o uso da assistência de IA</label>
            <p>Esta autorização é opcional e separada da aceitação dos termos. <%= link_to "Saiba como os serviços de IA funcionam", ai_help_path, target: "_blank", rel: "noopener" %>.</p>
          </div>
          <%= form.submit "Salvar consentimentos", class: "button button-primary" %>
        <% end %>
      </section>

      <section class="settings-section" id="delete-account" aria-labelledby="delete-title">
        <h2 id="delete-title">Excluir conta</h2>
        <p>Todos os dados da sua conta serão excluídos permanentemente.</p>
        <%= form_with url: account_delete_path, method: :post do |form| %>
          <div class="field">
            <%= form.label :confirmation, "Digite #{@account.email} para confirmar" %>
            <%= form.email_field :confirmation, required: true, autocomplete: "off", class: "text-control" %>
          </div>
          <%= form.submit "Excluir minha conta e meus dados", class: "button button-danger" %>
        <% end %>
      </section>
    </div>
  </div>
</main>

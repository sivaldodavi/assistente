<% content_for :title, "#{@project.title} — Assistente Acadêmico" %>

<main class="page-shell editor-shell" data-ai-panel data-project-revision="<%= @project.lock_version %>" data-action-url="<%= "/projects/#{@project.id}/ai/action" %>" data-jev-report-url="<%= "/projects/#{@project.id}/ai/jev-report" %>" data-jev-section-url="<%= "/projects/#{@project.id}/ai/jev-section" %>" data-jev-assessment-url="<%= "/projects/#{@project.id}/ai/jev-assessment" %>">
  <div class="editor-heading">
    <div>
      <p class="eyebrow"><%= @project.project_type == "case" ? "Roteiro de Case" : @project.project_type == "paper_final" ? "Paper Final" : "Projeto de Paper" %></p>
      <h1><%= @project.title %></h1>
    </div>
    <div class="editor-heading-actions" aria-label="Ações do projeto">
      <%= link_to "Abrir Chat", chat_path(project_id: @project.id, scope: @stage["id"]), class: "button button-secondary" %>
      <% if @assessment_stage %>
        <button class="button button-primary" type="button" data-jev-assessment data-jev-assessment-stage="<%= @assessment_stage %>">Avaliar etapa</button>
      <% end %>
    </div>
    <div class="progress-chip" aria-label="Progresso dos campos obrigatórios nesta fase">
      <strong><%= @progress["percent"] %>%</strong>
      <span><%= @progress["done"] %>/<%= @progress["total"] %> campos</span>
    </div>
  </div>

  <section class="export-panel export-panel-top" aria-label="Prévia e exportação">
    <div class="export-controls">
      <% if @project.project_type == "case" %>
        <label class="preview-picker">
          <span class="visually-hidden">Documento da prévia</span>
          <%= select_tag "preview_phase", options_for_select([
            ["Relatório", export_project_path(@project, format: :html, phase: :report)],
            ["Debate", export_project_path(@project, format: :html, phase: :debate)],
            ["Dissertação", export_project_path(@project, format: :html, phase: :dissertation)]
          ]), class: "text-control", aria: { label: "Documento da prévia" }, data: { preview_select: true } %>
        </label>
      <% end %>
      <%= link_to "Prévia", export_project_path(@project, format: :html, phase: (@project.project_type == "case" ? :report : nil)), target: "_blank", rel: "noopener", class: "button button-secondary", data: { preview_link: true } %>
      <%= link_to "PDF", export_project_path(@project, format: :pdf, phase: (@project.project_type == "case" ? :report : nil)), class: "button button-primary" %>
    </div>
  </section>

  <%= form_with model: @project, url: project_path(@project), method: :patch, id: "project-editor", class: "editor-form" do %>
    <%= hidden_field_tag "project[lock_version]", @project.lock_version %>
    <%= hidden_field_tag "project[current_stage]", @stage["id"] %>

    <div class="editor-layout">
      <aside class="editor-stage-sidebar" aria-label="Navegação do roteiro">
        <% @stages.each_with_index.group_by { |stage, _index| stage["phase"] }.each do |phase, phase_stages| %>
          <section class="editor-phase-group" aria-label="<%= phase.humanize %>">
            <p class="editor-phase-title"><%= phase.humanize %></p>
            <nav class="editor-stage-list" aria-label="Etapas de <%= phase.humanize %>">
              <% phase_stages.each do |stage, index| %>
                <%= button_tag "#{format('%02d', index + 1)} · #{stage['title']}",
                  type: "submit",
                  name: "go_to_stage",
                  value: stage["id"],
                  class: ["step-nav-item", ("is-current" if stage["id"] == @stage["id"])].compact.join(" "),
                  aria: { current: stage["id"] == @stage["id"] ? "step" : nil } %>
              <% end %>
            </nav>
          </section>
          <% end %>
      </aside>
      <div class="editor-stage-content">
      <section class="stage-card" aria-labelledby="stage-title">
      <p class="eyebrow"><%= @stage["phase"].humanize %> · Etapa <%= format("%02d", @stage_index + 1) %></p>
      <h2 id="stage-title"><%= @stage["title"] %></h2>
      <p class="stage-intro"><%= @stage["intro"] %></p>
      <% @project.schedule_warnings.each do |warning| %>
        <p class="flash flash-alert" role="status"><%= warning %></p>
      <% end %>

      <% paired = @stage["custom"] == "reuse_decisions" %>
      <div class="field-grid<%= " field-grid-paired" if paired %>">
        <% group_titles = (@stage["groups"] || []).to_h %>
        <% last_group = nil %>
        <% @stage.fetch("fields", []).each do |field| %>
          <% if field["group"].present? && field["group"] != last_group %>
            <h3 class="field-group-title"><%= group_titles[field["group"]] %></h3>
          <% end %>
          <% last_group = field["group"] %>
          <% describedby = field["hint"].present? ? "hint-#{field["id"]}" : nil %>
          <div class="field" data-row="<%= field["row"] %>">
            <div class="field-label-row">
              <%= label_tag "project_fields_#{field["id"]}", AcademicWorkflow.field_label(@project.fields, field), class: ("alternative-title" if paired) %>
              <% if field["required"] %><span class="required-label">Obrigatório</span><% end %>
            </div>
            <% name = "project[fields][#{field["id"]}]" %>
            <% value = @project.fields[field["id"]] %>
            <% value = Date.current.year.to_s if field["id"] == "year" && value.blank? %>
            <% value = current_account.profile[field["id"]] if value.blank? && %w[period shift].include?(field["id"]) %>
            <% if field["type"] == "date" %>
              <%= date_field_tag name, value, id: "project_fields_#{field["id"]}", class: "text-control", aria: { required: field["required"], describedby: describedby } %>
            <% elsif field["type"] == "textarea" %>
              <%= text_area_tag name, value, id: "project_fields_#{field["id"]}", rows: field["size"] == "large" ? 8 : 4, maxlength: field["limit"], placeholder: field["placeholder"], class: "text-control", aria: { required: field["required"], describedby: describedby } %>
            <% elsif field["type"] == "select" %>
              <% if field["source"].present? %>
                <% source_values = Array(current_account.profile[field["source"]]) %>
                <% source_values << value if value.present? && !source_values.include?(value) %>
                <% options = [["Selecione…", ""]] + source_values.map { |option| [option, option] } %>
              <% else %>
                <% options = field.fetch("options", []).map { |option_value, label| [label, option_value] } %>
              <% end %>
              <%= select_tag name, options_for_select(options, value), id: "project_fields_#{field["id"]}", class: "text-control", aria: { required: field["required"], describedby: describedby } %>
            <% else %>
              <%= text_field_tag name, value, id: "project_fields_#{field["id"]}", maxlength: field["limit"], placeholder: field["placeholder"], class: "text-control", aria: { required: field["required"], describedby: describedby } %>
            <% end %>
            <% if field["hint"].present? %><p id="<%= describedby %>" class="field-hint"><%= field["hint"] %></p><% end %>
            <% source = AcademicWorkflow::ARGUMENT_TITLE_SOURCES[field["id"]] %>
            <% if paired && source && @project.fields[source].blank? %><p class="field-hint">Preencha esta alternativa na <%= link_to "etapa 2.1", project_path(@project, stage: "decisions") %>.</p><% end %>
            <% if field["source"].present? && Array(current_account.profile[field["source"]]).empty? %>
              <p class="field-hint">Cadastre suas opções em <%= link_to "configurações da conta", account_settings_path %>.</p>
            <% end %>
          </div>
        <% end %>
      </div>

      <% case @stage["custom"] %>
      <% when "criteria" %>
        <%= render "collection", kind: "criteria", items: @project.criteria, title: "Critérios e valores" %>
      <% when "development" %>
        <%= render "collection", kind: "development_sections", items: @project.development_sections, title: "Tópicos do desenvolvimento" %>
      <% when "sources" %>
        <fieldset class="source-picker">
          <legend>Fontes da Biblioteca Pessoal</legend>
          <p class="field-hint">Selecione as referências usadas neste trabalho. Seus fichamentos permanecem privados na biblioteca.</p>
          <%= hidden_field_tag "project[source_ids][]", "" %>
          <% if @sources.any? %>
            <div class="source-picker-list">
              <% @sources.each do |source| %>
                <label class="check-row source-picker-item">
                  <%= check_box_tag "project[source_ids][]", source.public_id, @project.source_ids.include?(source.public_id) %>
                  <span><strong><%= source.title %></strong><% if source.author.present? %><small><%= source.author %></small><% end %></span>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="muted">Sua biblioteca está vazia. <%= link_to "Adicionar uma fonte", library_path %>.</p>
          <% end %>
        </fieldset>
      <% when "review" %>
        <section class="review-card" aria-label="Resumo da revisão">
          <div class="review-score"><strong><%= @review_summary["percent"] %>%</strong><span><%= @review_summary["done"] %> de <%= @review_summary["total"] %> conferências</span></div>
          <% if @review_summary["groups"].any? %>
            <% @review_summary["groups"].each do |group| %>
              <details class="review-group" <%= "open" if group["done"] == group["total"] %>>
                <summary><span><%= group["title"] %></span><span><%= group["done"] %>/<%= group["total"] %></span></summary>
                <ul>
                  <% group["items"].each do |item| %>
                    <li class="<%= item["done"] ? "is-done" : "is-pending" %>"><%= item["done"] ? "✓" : "○" %> <%= item["label"] %></li>
                  <% end %>
                </ul>
              </details>
            <% end %>
          <% else %>
            <p class="muted">Não há conferências automáticas nesta fase.</p>
          <% end %>
          <% if @project.delivered?(@stage) %>
            <p class="success-note">Entrega registrada.</p>
          <% else %>
            <%= button_tag "Registrar entrega", type: "submit", name: "mark_delivered", value: "1", class: "button button-secondary" %>
          <% end %>
          <% if @project.project_type == "paper_project" && @stage["id"] == "review_paper" %>
            <%= button_tag "Avançar para Paper Final", type: "submit", formaction: paper_mode_project_path(@project), class: "button button-primary" %>
          <% end %>
          </section>
          </div>
        </div>
      <% end %>

      <% if @stage.fetch("checks", []).any? %>
        <fieldset class="checklist">
          <legend>Conferência da etapa</legend>
          <% @stage["checks"].each do |key, label| %>
            <label class="check-row">
              <%= hidden_field_tag "project[checks][#{key}]", "0" %>
              <%= check_box_tag "project[checks][#{key}]", "1", @project.checks[key] == true %>
              <span><%= label %></span>
            </label>
          <% end %>
        </fieldset>
      <% end %>

      <details class="assist-panel" id="assist-panel">
        <summary class="assist-panel-summary" aria-controls="assist-panel-body">
          <strong id="assist-panel-title">Sugestões para o roteiro</strong>
        </summary>
        <div class="assist-panel-body" id="assist-panel-body">
        <button class="assist-panel-close" type="button" data-assist-close>Fechar</button>
        <p class="field-hint">As sugestões não alteram o roteiro automaticamente.</p>
        <label class="assist-message-label" for="ai-assist-message">O que você quer analisar?</label>
        <textarea class="text-control" id="ai-assist-message" rows="3" maxlength="6000" data-ai-message placeholder="Descreva o que deseja revisar."></textarea>
        <div class="assist-actions">
          <button class="button button-secondary" type="button" data-ai-action="suggest_problem">Revisar problema</button>
          <button class="button button-secondary" type="button" data-ai-action="suggest_theses"><%= @project.project_type == "case" ? "Analisar decisões possíveis" : "Analisar hipótese e objetivos" %></button>
        </div>
        <p class="field-hint" data-ai-status role="status" aria-live="polite"></p>
        <div class="assist-response" data-ai-response aria-live="polite"></div>

        <div class="jev-tools">
          <p class="field-hint">Avaliação indicativa, não é nota oficial.</p>
          <% if @project.project_type == "case" %>
            <div class="assist-actions">
              <label class="jev-section-picker">Checklist de uma seção
                <%= select_tag "jev_section", options_for_select([
                  ["Descrição do caso", "case_description"],
                  ["Decisões possíveis", "case_decisions"],
                  ["Alternativa A", "thesis_a"],
                  ["Alternativa B", "thesis_b"],
                  ["Critérios e valores", "criteria_and_values"]
                ]), class: "text-control", data: { jev_section_select: true } %>
              </label>
              <button class="button button-secondary" type="button" data-jev-section-action>Avaliar seção</button>
            </div>
          <% end %>
          <p class="field-hint" data-jev-status role="status" aria-live="polite"></p>
          <div class="jev-response" data-jev-response aria-live="polite"></div>
          <% if @jev_assessments.any? %>
            <details class="jev-history">
              <summary>Histórico das últimas avaliações</summary>
              <ol>
                <% @jev_assessments.each do |assessment| %>
                  <li>
                    <strong><%= jev_stage_label(assessment.stage) %></strong> · <%= jev_assessment_score(assessment) %>
                    <span>Revisão <%= assessment.project_revision.revision %> · <%= assessment.created_at.strftime("%d/%m/%Y %H:%M") %></span>
                    <% if assessment.result["points_discrepancy"] %>
                      <span>Os critérios publicados somam <%= assessment.result["assessable_points"] %> pontos, embora a etapa seja declarada como <%= assessment.result["declared_points"] %>.</span>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            </details>
          <% end %>
        </div>
        </div>
      </details>
      <button class="assist-sheet-backdrop" type="button" data-assist-backdrop aria-label="Fechar apoio acadêmico" hidden></button>

      <div class="editor-actions">
        <% if @previous_stage %>
          <%= button_tag "← Etapa anterior", type: "submit", name: "go_to_stage", value: @previous_stage["id"], class: "button button-secondary" %>
        <% else %>
          <span></span>
        <% end %>
        <% if @next_stage %>
          <%= button_tag "Salvar e continuar →", type: "submit", name: "go_to_stage", value: @next_stage["id"], class: "button button-primary" %>
        <% else %>
          <%= button_tag "Salvar alterações", type: "submit", class: "button button-primary" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <div class="danger-zone">
    <%= button_to "Excluir este projeto", project_path(@project), method: :delete, form: { data: { turbo_confirm: "Excluir este projeto e suas revisões?" } }, class: "text-button danger-text" %>
  </div>
</main>

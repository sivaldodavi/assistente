<% content_for :title, "Projetos — Assistente Acadêmico" %>

<main class="page-shell projects-page" data-project-view="board">
  <header class="page-heading">
    <div>
      <p class="eyebrow">Seu espaço de trabalho</p>
      <h1>Projetos</h1>
      <p>Encontre seus trabalhos e acompanhe o próximo passo.</p>
    </div>
    <%= link_to "+ Novo projeto", new_project_path, class: "button button-primary" %>
    <%= link_to "Começar com IA", project_assistant_path, class: "button button-secondary" %>
  </header>

  <div class="project-toolbar">
    <div class="project-filters" role="group" aria-label="Filtrar projetos">
      <button class="filter-chip" type="button" data-project-filter="all" aria-pressed="true">Todos</button>
      <button class="filter-chip" type="button" data-project-filter="case" aria-pressed="false">Cases</button>
      <button class="filter-chip" type="button" data-project-filter="paper" aria-pressed="false">Papers</button>
    </div>
    <div class="view-switch" role="group" aria-label="Visualização dos projetos">
      <button type="button" data-project-view-button="board" aria-pressed="true">Quadro</button>
      <button type="button" data-project-view-button="list" aria-pressed="false">Lista</button>
    </div>
  </div>

  <% if @projects.any? %>
    <% groups = [
      [ "in-progress", "Em andamento" ],
      [ "review", "Em revisão" ],
      [ "delivered", "Entregue" ]
    ] %>
    <div class="project-board" aria-label="Projetos por estado">
      <% groups.each do |status, label| %>
        <% projects = @projects.select { |project| project_status(project).last == status } %>
        <section class="project-board-column" data-project-column="<%= status %>">
          <h2><%= label %><span data-column-count><%= projects.size %></span></h2>
          <div class="project-board-items">
            <% projects.each do |project| %>
              <%= render "project_card", project: %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <div class="project-list-view">
      <table class="project-table">
        <thead><tr><th>Projeto</th><th>Estado</th><th>Progresso</th><th>Próxima entrega</th></tr></thead>
        <tbody>
          <% @projects.each do |project| %>
            <% status_label, status_key = project_status(project) %>
            <% delivery = next_project_delivery(project) %>
            <% kind = project.project_type == "case" ? "case" : "paper" %>
            <tr data-project-card data-project-kind="<%= kind %>" data-project-status="<%= status_key %>">
              <td>
                <%= link_to project.title, project_path(project, stage: project.current_stage) %><br>
                <span class="project-type"><%= project_type_label(project.project_type) %></span>
                <% if (assessment = project.latest_jev_assessment) %>
                  <br><span class="project-jev-score">Avaliação · <%= jev_stage_label(assessment.stage) %>: <%= jev_assessment_score(assessment) %></span>
                  <br><span class="project-jev-date">Revisão <%= assessment.project_revision.revision %> · avaliação formativa</span>
                <% end %>
              </td>
              <td><span class="status-pill" data-status="<%= status_key %>"><%= status_label %></span></td>
              <td><%= project.progress["done"] %>/<%= project.progress["total"] %> campos</td>
              <td><%= delivery ? "#{delivery[:date].strftime("%d/%m/%Y")} · #{delivery[:label]}" : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="empty-state-copy" data-project-filter-empty hidden role="status">Nenhum projeto corresponde a este filtro.</p>
  <% else %>
    <section class="empty-state project-empty-state">
      <p class="eyebrow">Seu próximo passo</p>
      <h2>Nenhum projeto por aqui ainda</h2>
      <p>Comece por um Case ou por um Projeto de Paper.</p>
      <%= link_to "Criar primeiro projeto", new_project_path, class: "button button-primary" %>
    </section>
  <% end %>
</main>

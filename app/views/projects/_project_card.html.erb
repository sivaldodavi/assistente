<% status_label, status_key = project_status(project) %>
<% kind = project.project_type == "case" ? "case" : "paper" %>
<% delivery = next_project_delivery(project) %>
<article class="project-card" data-project-card data-project-kind="<%= kind %>" data-project-status="<%= status_key %>">
  <div class="project-card-meta">
    <span class="project-type"><%= project_type_label(project.project_type) %></span>
    <span class="status-pill" data-status="<%= status_key %>"><%= status_label %></span>
  </div>
  <h3><%= link_to project.title, project_path(project, stage: project.current_stage) %></h3>
  <p><%= project.section_for["title"] %></p>
  <p class="dashboard-progress"><%= project.progress["done"] %> de <%= project.progress["total"] %> campos obrigatórios</p>
  <% if delivery %><p class="project-delivery-hint">Próxima: <%= delivery[:date].strftime("%d/%m/%Y") %> · <%= delivery[:label] %></p><% end %>
</article>

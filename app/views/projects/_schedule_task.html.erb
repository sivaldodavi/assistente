<div class="task-row" data-task>
  <%= hidden_field_tag "project[schedule][tasks][#{index}][id]", task["id"] %>
  <%= hidden_field_tag "project[schedule][tasks][#{index}][done]", "0" %>
  <label class="task-row-done" title="Marcar tarefa como concluída">
    <%= check_box_tag "project[schedule][tasks][#{index}][done]", "1", task["done"] == true, data: { task_field: "done" } %>
    <span class="visually-hidden">Concluir tarefa</span>
  </label>
  <%= text_field_tag "project[schedule][tasks][#{index}][title]", task["title"], maxlength: 180, placeholder: "Tarefa", class: "text-control task-row-title", data: { task_field: "title" } %>
  <label class="task-row-date"><span>Prazo de entrega</span><%= date_field_tag "project[schedule][tasks][#{index}][date]", task["date"], class: "text-control", aria: { label: "Prazo de entrega da tarefa" }, data: { task_field: "date" } %></label>
  <button type="button" class="text-button danger-text" data-remove-task>Remover</button>
</div>
